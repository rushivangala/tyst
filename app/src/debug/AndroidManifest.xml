<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only screens and a stand-in password manager. None of this ships in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="app.tyst.keyboard.TestEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <activity
            android:name="app.tyst.keyboard.TestLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name="app.tyst.keyboard.TestAutofillService"
            android:exported="true"
            android:label="Tyst test logins"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/test_autofill_service" />
        </service>
    </application>
</manifest>
